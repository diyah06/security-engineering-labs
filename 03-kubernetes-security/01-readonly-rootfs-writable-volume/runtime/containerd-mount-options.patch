@@ -0,0 +1,27 @@
+// Lab-only CRI compatibility implementation; not an upstream containerd release.
+package opts
+
+import "fmt"
+
+// lab01BindMountOptions preserves unrelated options and gives CRI security flags
+// precedence over their opposites. Reject anything outside the Kubernetes API.
+func lab01BindMountOptions(base, requested []string) ([]string, error) {
+    result := append([]string(nil), base...)
+    for _, option := range requested {
+        var opposite string
+        switch option {
+        case "noexec": opposite = "exec"
+        case "nosuid": opposite = "suid"
+        case "nodev": opposite = "dev"
+        default: return nil, fmt.Errorf("unsupported CRI bind mount option %q", option)
+        }
+        filtered := result[:0]
+        for _, existing := range result {
+            if existing != option && existing != opposite {
+                filtered = append(filtered, existing)
+            }
+        }
+        result = append(filtered, option)
+    }
+    return result, nil
+}
