@@ -0,0 +1,29 @@
+package opts
+
+import (
+    "reflect"
+    "testing"
+)
+
+func TestLab01BindMountOptions(t *testing.T) {
+    tests := []struct {
+        name string
+        base, requested, want []string
+        wantErr bool
+    }{
+        {"baseline unchanged", []string{"rbind", "rprivate", "rw"}, nil, []string{"rbind", "rprivate", "rw"}, false},
+        {"security flags", []string{"rbind", "rw"}, []string{"noexec", "nosuid", "nodev"}, []string{"rbind", "rw", "noexec", "nosuid", "nodev"}, false},
+        {"conflicts and duplicates", []string{"ro", "exec", "suid", "dev", "noexec"}, []string{"noexec", "nosuid", "nodev", "noexec"}, []string{"ro", "nosuid", "nodev", "noexec"}, false},
+        {"reject weakening flag", []string{"ro"}, []string{"exec"}, nil, true},
+        {"reject unknown flag", []string{"rw"}, []string{"invalid"}, nil, true},
+    }
+    for _, tt := range tests {
+        t.Run(tt.name, func(t *testing.T) {
+            original := append([]string(nil), tt.base...)
+            got, err := lab01BindMountOptions(tt.base, tt.requested)
+            if (err != nil) != tt.wantErr { t.Fatalf("unexpected error: %v", err) }
+            if !reflect.DeepEqual(got, tt.want) { t.Fatalf("got %v, want %v", got, tt.want) }
+            if !reflect.DeepEqual(tt.base, original) { t.Fatal("input options were mutated") }
+        })
+    }
+}
